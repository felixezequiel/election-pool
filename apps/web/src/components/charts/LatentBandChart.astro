---
/**
 * <LatentBandChart> — herói (docs/05 §5, §6; docs/06 §1).
 *
 * Série `μ_t` com banda 90%. A BANDA é o dado dominante; a linha central é
 * secundária; os pontos das pesquisas ficam por trás (opacidade baixa, r3px).
 * NÃO inverter essa hierarquia (armadilha da task).
 *
 * SSR-completo (docs/06 §1): o SVG do build já é o estado final e correto — sem
 * JS o gráfico aparece inteiro. A hidratação só adiciona:
 *   - orquestração de load: bandas crescem ANTES das linhas e dos pontos;
 *   - scrub: cursor vertical; os valores da data animam em <AnimatedNum>, cada
 *     um com sua UncertaintyRule ao lado (nº de destaque nunca sem régua);
 *   - tooltip por hover/foco de ponto, navegável por teclado (setas), Escape
 *     fecha;
 *   - transição de atualização: expõe `window.__latentUpdate(id, series)` para
 *     T-12 republicar sem "pulo".
 *
 * Cor segue a entidade (colorSlot), nunca a posição (docs/05 §2.1 regra 2).
 */
import AnimatedNum from '../AnimatedNum.astro';
import CandidatePhoto from '../CandidatePhoto.astro';
import Num from '../Num.astro';
import UncertaintyRule from './UncertaintyRule.astro';
import HachuraDefs from './HachuraDefs.astro';
import {
  buildLatentGeometry,
  buildSparklines,
  type LatentSeries,
  type PollPoint,
} from './lib/latent-geometry.js';
import { hachuraFill } from './lib/hachura.js';
import { formatPct, formatDayMonth, isoDateOnly } from './lib/format.js';
import './lib/charts.css';

export interface PollTooltipMeta {
  tseId: string;
  instituteName: string;
  contractorName: string;
  contractorType: string;
  sampleSize: number;
  fieldStart: string;
  fieldEnd: string;
  /** Valores por candidato (id → pct) desta pesquisa neste cenário. */
  values: Record<string, number>;
}

interface Props {
  /** Séries por candidato (banda + média). Ordem = ordem de plotagem/legenda. */
  series: LatentSeries[];
  /** Pontos de pesquisa individuais já mapeados (sem x/y — calculados aqui). */
  points: Omit<PollPoint, 'x' | 'y'>[];
  /** Metadados de tooltip por tseId (instituto, contratante, n, datas, valores). */
  pollMeta: Record<string, PollTooltipMeta>;
  /** Título curto do gráfico (ex.: "1º turno — últimos 90 dias"). */
  title: string;
  /** id único do gráfico (namespace de padrões e do script). */
  id: string;
  width?: number;
  height?: number;
  /**
   * Faixa de mini-trajetórias por candidato (uma sparkline cada, mesma escala).
   * Default: só quando há mais de 2 séries — num par de 2º turno o readout já
   * mostra os dois e a faixa seria redundante.
   */
  showSparklines?: boolean;
  class?: string | undefined;
}

const {
  series,
  points,
  pollMeta,
  title,
  id,
  width = 960,
  height = 420,
  showSparklines,
  class: className,
} = Astro.props;

// Margem direita larga: é onde ficam os RÓTULOS DE FIM DE LINHA (nome + valor de
// cada candidato). Sem eles o gráfico não se identifica — "qual linha é qual?" é
// justamente a queixa que eles resolvem.
const margins = { top: 16, right: 156, bottom: 32, left: 40 };
const geo = buildLatentGeometry(series, points, width, height, margins);

const slots = [...new Set(series.map((s) => s.colorSlot))];

// Mini-trajetórias: mesma escala (xDomain/yDomain) do gráfico grande, para que a
// oscilação de cada candidato seja comparável batendo o olho (docs/06 §8 P&B).
const SPARK_W = 172;
const SPARK_H = 40;
const withSparks = showSparklines ?? series.length > 2;
const sparklines = withSparks
  ? buildSparklines(series, SPARK_W, SPARK_H, geo.xDomain, geo.yDomain)
  : [];
const sparkById = new Map(sparklines.map((s) => [s.candidateId, s]));

// Último ponto de cada série: valor "de agora" para o readout de scrub e a régua.
function latestOf(s: LatentSeries): { date: number; mean: number; lo90: number; hi90: number } {
  const last = s.samples[s.samples.length - 1];
  if (!last) return { date: geo.xDomain[1], mean: 0, lo90: 0, hi90: 0 };
  return { date: last.t, mean: last.mean, lo90: last.lo90, hi90: last.hi90 };
}
const latest = new Map(series.map((s) => [s.candidateId, latestOf(s)]));

// Domínio de valor compartilhado entre as réguas do readout (comparáveis lado a lado).
const ruleDomain: [number, number] = [geo.yDomain[0], geo.yDomain[1]];

// ── Rótulos de fim de linha ────────────────────────────────────────────────
// Cada linha ganha um rótulo (nome + valor) na ponta direita, na cor da entidade.
// Como as linhas se amontoam embaixo, os rótulos são AFASTADOS na vertical (de-
// colisão) e ligados ao ponto real por um conector curvo — o gráfico passa a
// "dizer quem é" sem depender de hover nem de ler a legenda.
const plotRight = width - margins.right;
const labelX = plotRight + 14;
const END_LABEL_GAP = 15; // px mínimos entre rótulos empilhados
const firstName = (name: string): string => name.split(/\s+/)[0] ?? name;
interface EndLabel {
  candidateId: string;
  colorSlot: number;
  name: string;
  mean: number;
  yLine: number;
  yLabel: number;
}
const endLabels: EndLabel[] = series
  .map((s): EndLabel => {
    const l = latest.get(s.candidateId);
    const mean = l?.mean ?? 0;
    const y = geo.y(mean);
    return { candidateId: s.candidateId, colorSlot: s.colorSlot, name: firstName(s.displayName), mean, yLine: y, yLabel: y };
  })
  .sort((a, b) => a.yLine - b.yLine);
// De-colisão: empilha para baixo respeitando o gap; se estourar o rodapé, sobe tudo.
let prevY = Number.NEGATIVE_INFINITY;
for (const l of endLabels) {
  l.yLabel = Math.max(l.yLine, prevY + END_LABEL_GAP);
  prevY = l.yLabel;
}
const labelBottom = height - margins.bottom;
const labelOverflow = (endLabels[endLabels.length - 1]?.yLabel ?? 0) - labelBottom;
if (labelOverflow > 0) for (const l of endLabels) l.yLabel -= labelOverflow;

// Prosa do <desc> (docs/05 §7) — leitura em voz alta que faz sentido.
const descParts = series.map((s) => {
  const l = latest.get(s.candidateId);
  return `${s.displayName}: central ${formatPct(l?.mean ?? 0)}%, faixa de 90% de ${formatPct(
    l?.lo90 ?? 0,
  )} a ${formatPct(l?.hi90 ?? 0)}`;
});
const desc = `Série de apoio estimado ao longo do tempo com faixa de incerteza de 90% dominante. ${descParts.join(
  '; ',
)}. A faixa é o elemento principal; a linha central é secundária.`;

// Datas ordenadas para o equivalente textual (tabela).
const tableDates = series[0]?.samples.map((p) => p.t) ?? [];

// Serialização do estado para o script (datas em ms; nada de aleatório).
const clientSeries = series.map((s) => ({
  candidateId: s.candidateId,
  displayName: s.displayName,
  colorSlot: s.colorSlot,
  photoPath: s.photoPath ?? null,
  samples: s.samples,
}));
---

<figure class:list={['chart latent-chart', className]} data-latent-chart data-chart-id={id}>
  <figcaption class="label">{title}</figcaption>

  <div class="chart-plot substrate-plot">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-labelledby={`${id}-title ${id}-desc`}
      preserveAspectRatio="xMidYMid meet"
    >
      <title id={`${id}-title`}>{title}</title>
      <desc id={`${id}-desc`}>{desc}</desc>

      <defs>
        <HachuraDefs idPrefix={id} slots={slots} />
        {
          series.map((s) => (
            <linearGradient id={`${id}-band-grad-${s.colorSlot}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color={`var(--c${s.colorSlot})`} stop-opacity="0.9" />
              <stop offset="100%" stop-color={`var(--c${s.colorSlot})`} stop-opacity="0.35" />
            </linearGradient>
          ))
        }
      </defs>

      {/* Substrato: eixos e ticks — instantâneos, nunca animados. */}
      <g class="axes" aria-hidden="true">
        {
          geo.yTicks.map((t) => (
            <g>
              <line class="axis-tick" x1={margins.left} y1={t.pos} x2={width - margins.right} y2={t.pos} />
              <text class="axis-label" x={margins.left - 6} y={t.pos + 3} text-anchor="end">
                {t.label}
              </text>
            </g>
          ))
        }
        {
          geo.xTicks.map((t) => (
            <text
              class="axis-label"
              x={t.pos}
              y={height - margins.bottom + 18}
              text-anchor="middle"
            >
              {t.label}
            </text>
          ))
        }
        <line
          class="axis-line"
          x1={margins.left}
          y1={height - margins.bottom}
          x2={width - margins.right}
          y2={height - margins.bottom}></line>
      </g>

      {/* Pontos das pesquisas: por trás das bandas (docs/06 §2 "por trás"). */}
      <g class="poll-points">
        {
          geo.points.map((p) => (
            <g class="poll-point-g" style={`color: var(--c${p.colorSlot})`}>
              <circle
                class="poll-point"
                data-poll-point
                data-tse-id={p.tseId}
                data-candidate={p.candidateId}
                cx={p.x}
                cy={p.y}
                r={3}
                fill="currentColor"
                tabindex="0"
                role="button"
                aria-label={`Pesquisa ${p.tseId}, ${formatPct(p.value)} por cento`}
              />
              <circle class="poll-focus-ring" cx={p.x} cy={p.y} r={6} />
            </g>
          ))
        }
      </g>

      {/* Bandas: DOMINANTES. Cor por slot + hachura sobreposta. */}
      <g class="bands">
        {
          geo.bands.map((b) => (
            <g
              class="band-group"
              data-candidate={b.candidateId}
              style={`color: var(--c${b.colorSlot}); --band-delay: ${slots.indexOf(b.colorSlot) * 80}ms`}
            >
              <path
                class="band"
                d={b.path}
                fill={`url(#${id}-band-grad-${b.colorSlot})`}
                data-band
                data-candidate={b.candidateId}
              />
              <path class="band-hachura" d={b.path} fill={hachuraFill(id, b.colorSlot)} />
            </g>
          ))
        }
      </g>

      {/* Linhas centrais: SECUNDÁRIAS (1.5px, 60% opacidade). */}
      <g class="center-lines">
        {
          geo.centers.map((c) => (
            <path
              class="center-line"
              d={c.path}
              stroke={`var(--c${c.colorSlot})`}
              data-center
              data-candidate={c.candidateId}
            />
          ))
        }
      </g>

      {/* Rótulos de fim de linha: cada linha diz QUEM é, na cor da entidade, sem
          depender de hover nem da legenda. Conector curvo liga o ponto real ao
          rótulo afastado (de-colisão vertical no frontmatter). */}
      <g class="end-labels">
        {
          endLabels.map((l) => (
            <g class="end-label" data-candidate={l.candidateId} style={`color: var(--c${l.colorSlot})`}>
              <path
                class="end-label-connector"
                d={`M ${plotRight} ${l.yLine} C ${plotRight + 10} ${l.yLine}, ${labelX - 10} ${l.yLabel}, ${labelX} ${l.yLabel}`}
              />
              <circle class="end-label-dot" cx={labelX} cy={l.yLabel} r={3.5} />
              <text class="end-label-name" x={labelX + 8} y={l.yLabel + 3.6}>
                {l.name} <tspan class="end-label-val">{formatPct(l.mean)}%</tspan>
              </text>
            </g>
          ))
        }
      </g>

      {/* Cursor de scrub + área de captura (mouse e teclado). */}
      <line
        class="scrub-line"
        data-scrub-line
        x1={margins.left}
        y1={margins.top}
        x2={margins.left}
        y2={height - margins.bottom}></line>
      <rect
        class="scrub-hit"
        data-scrub-hit
        x={margins.left}
        y={margins.top}
        width={geo.innerWidth}
        height={geo.innerHeight}
        tabindex="0"
        role="slider"
        aria-label="Deslize para ler os valores estimados por data"
        aria-valuemin={geo.xDomain[0]}
        aria-valuemax={geo.xDomain[1]}
        aria-valuenow={geo.xDomain[1]}></rect>
    </svg>

    {/* Tooltip (preenchido pela hidratação; vazio e oculto no SSR). */}
    <div class="chart-tooltip" data-tooltip role="tooltip" aria-hidden="true"></div>

    {/* Tooltip da LINHA: acompanha o scrub, com FOTO + valor de cada candidato na
        data sob o cursor. Pré-renderizado (foto/monograma reusam o <CandidatePhoto>);
        o JS só posiciona e atualiza os valores. Some sem JS (aria-hidden). Sob foco,
        só a linha do candidato em foco aparece (as demais recebem .is-dim). */}
    <div class="scrub-tip" data-scrub-tip aria-hidden="true">
      <p class="scrub-tip-date" data-scrub-tip-date>
        {formatDayMonth(new Date(geo.xDomain[1]).toISOString())}
      </p>
      <ul class="scrub-tip-list">
        {
          series.map((s) => (
            <li class="scrub-tip-row" data-scrub-tip-row data-candidate={s.candidateId}>
              <CandidatePhoto
                photoPath={s.photoPath ?? null}
                displayName={s.displayName}
                colorSlot={s.colorSlot}
                size={22}
              />
              <span class="scrub-tip-name">{s.displayName}</span>
              <span class="scrub-tip-val" data-scrub-tip-val data-candidate={s.candidateId}>
                {formatPct(latest.get(s.candidateId)?.mean ?? 0)}%
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {/* Readout de scrub: valor "de agora" por candidato, que ANIMA, sempre com a
      régua ao lado. Sem JS mostra o valor da última data (correto). */}
  <div class="scrub-readout" data-scrub-readout>
    <p class="label">
      Valores em <time datetime={isoDateOnly(new Date(geo.xDomain[1]).toISOString())}
        >{formatDayMonth(new Date(geo.xDomain[1]).toISOString())}</time
      >
    </p>
    <ul class="readout-list">
      {
        series.map((s) => {
          const l = latest.get(s.candidateId);
          return (
            <li class="readout-item" data-candidate={s.candidateId}>
              <span class="readout-name">
                {/* Identidade do candidato: foto quando existe, monograma quando
                    não. Decorativa (alt=""), porque o nome vem logo em seguida. */}
                <CandidatePhoto
                  photoPath={s.photoPath ?? null}
                  displayName={s.displayName}
                  colorSlot={s.colorSlot}
                  size={26}
                />
                {s.displayName}
              </span>
              <span class="readout-value">
                <AnimatedNum
                  value={l?.mean ?? 0}
                  decimals={1}
                  suffix="%"
                  class={`readout-num readout-num-${id}`}
                  label={`${s.displayName}: ${formatPct(l?.mean ?? 0)} por cento`}
                />
                <span class="readout-num-tag" data-readout-num data-candidate={s.candidateId} />
              </span>
              <span class="readout-rule" data-rule-for={s.candidateId}>
                <UncertaintyRule
                  mean={l?.mean ?? 0}
                  lo90={l?.lo90 ?? 0}
                  hi90={l?.hi90 ?? 0}
                  colorSlot={s.colorSlot}
                  domain={ruleDomain}
                  label={s.displayName}
                  width={200}
                />
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>

  {/* Mini-trajetórias: uma por candidato, MESMA escala. Deixa ver quem oscila e
      quem não, sem o amontoado do gráfico grande. Cada item foca a série lá em cima
      (hover/foco realça, clique fixa). O gráfico grande fica legível por foco. */}
  {
    withSparks && (
      <div class="sparklines" data-sparklines>
        <p class="label sparklines-title">Como cada um oscila — mesma escala</p>
        <ul class="sparkline-list">
          {series.map((s) => {
            const sp = sparkById.get(s.candidateId);
            const l = latest.get(s.candidateId);
            return (
              <li>
                <button
                  type="button"
                  class="spark-trigger"
                  data-focus-trigger
                  data-candidate={s.candidateId}
                  aria-pressed="false"
                  aria-label={`${s.displayName}: apoio atual ${formatPct(l?.mean ?? 0)} por cento. Focar esta série.`}
                  style={`color: var(--c${s.colorSlot})`}
                >
                  <span class="spark-photo">
                    <CandidatePhoto
                      photoPath={s.photoPath ?? null}
                      displayName={s.displayName}
                      colorSlot={s.colorSlot}
                      size={24}
                    />
                  </span>
                  <span class="spark-head">
                    <span class="spark-name">{s.displayName}</span>
                    <span class="spark-val">
                      <Num>{formatPct(l?.mean ?? 0)}</Num>%
                    </span>
                  </span>
                  <svg
                    class="spark-svg"
                    viewBox={`0 0 ${SPARK_W} ${SPARK_H}`}
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path class="spark-band" d={sp?.bandPath} fill="currentColor" fill-opacity="0.2" />
                    <path
                      class="spark-line"
                      d={sp?.linePath}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      vector-effect="non-scaling-stroke"
                    />
                  </svg>
                </button>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }

  {/* Legenda: sempre visível, com cor + hachura (cor nunca sozinha). Cada item é um
      gatilho de foco (hover/foco realça a série; clique fixa; Esc solta). */}
  <ul class="chart-legend" data-legend>
    {
      series.map((s) => (
        <li>
          <button
            type="button"
            class="legend-trigger"
            data-focus-trigger
            data-candidate={s.candidateId}
            aria-pressed="false"
            aria-label={`Focar ${s.displayName}`}
          >
            <svg class="swatch" viewBox="0 0 18 12" width="18" height="12" aria-hidden="true" style={`color: var(--c${s.colorSlot})`}>
              <defs>
                <HachuraDefs idPrefix={`${id}-lg-${s.colorSlot}`} slots={[s.colorSlot]} />
              </defs>
              <rect x="0" y="0" width="18" height="12" rx="2" fill="currentColor" fill-opacity="0.22" />
              <rect x="0" y="0" width="18" height="12" rx="2" fill={hachuraFill(`${id}-lg-${s.colorSlot}`, s.colorSlot)} fill-opacity="0.5" />
            </svg>
            <span>{s.displayName}</span>
          </button>
        </li>
      ))
    }
  </ul>

  {/* Equivalente textual: tabela HTML real, fechada por padrão (docs/05 §7). */}
  <details class="chart-table">
    <summary>Ver dados da série em tabela</summary>
    <table>
      <caption>
        Apoio estimado (central) e faixa de <Num>90</Num>% por data, em pontos percentuais.
      </caption>
      <thead>
        <tr>
          <th scope="col">Data</th>
          {
            series.map((s) => (
              <th class="num" scope="col">
                {s.displayName}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          tableDates.map((t, i) => (
            <tr>
              <td>
                <time datetime={isoDateOnly(new Date(t).toISOString())}>
                  <Num>{formatDayMonth(new Date(t).toISOString())}</Num>
                </time>
              </td>
              {series.map((s) => {
                const p = s.samples[i];
                return (
                  <td class="num">
                    {p ? (
                      <>
                        <Num>{formatPct(p.mean)}</Num> (<Num>{formatPct(p.lo90)}</Num>–
                        <Num>{formatPct(p.hi90)}</Num>)
                      </>
                    ) : (
                      <Num>—</Num>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>

  <script
    is:inline
    type="application/json"
    data-latent-state
    set:html={JSON.stringify({ series: clientSeries, pollMeta, margins, width, height, ruleDomain, yDomain: geo.yDomain })}
  />
</figure>

<style>
  .latent-chart {
    margin-block: calc(var(--rhythm) * 2);
  }
  .chart-plot {
    position: relative;
  }
  .scrub-readout {
    margin-top: calc(var(--rhythm) * 2);
  }
  .readout-list {
    list-style: none;
    margin: var(--rhythm) 0 0;
    padding: 0;
    display: grid;
    gap: calc(var(--rhythm) * 1.5);
  }
  .readout-item {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) auto minmax(160px, 220px);
    align-items: center;
    gap: calc(var(--rhythm) * 2);
  }
  .readout-name {
    display: inline-flex;
    align-items: center;
    gap: var(--rhythm);
    font-family: var(--font-body);
    font-size: var(--fs-body-s);
    color: var(--ink);
  }
  .readout-value {
    font-family: var(--font-mono);
    font-size: var(--fs-data);
    font-variant-numeric: tabular-nums lining-nums;
    text-align: right;
    color: var(--ink);
  }
  .readout-num-tag {
    display: none;
  }
  @media (max-width: 640px) {
    .readout-item {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'name value'
        'rule rule';
    }
    .readout-name {
      grid-area: name;
    }
    .readout-value {
      grid-area: value;
    }
    .readout-rule {
      grid-area: rule;
    }
  }

  /* ── Foco interativo: um candidato em evidência, o resto recua ────────────── */
  .band-group,
  .center-line,
  .poll-points,
  .readout-item,
  .legend-trigger,
  .spark-trigger,
  .end-label {
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .latent-chart[data-focus] .band-group,
  .latent-chart[data-focus] .center-line,
  .latent-chart[data-focus] .readout-item,
  .latent-chart[data-focus] .legend-trigger,
  .latent-chart[data-focus] .spark-trigger,
  .latent-chart[data-focus] .end-label {
    opacity: 0.16;
  }
  .latent-chart[data-focus] .poll-points {
    opacity: 0.08;
  }
  .latent-chart[data-focus] .band-group.is-focus,
  .latent-chart[data-focus] .center-line.is-focus,
  .latent-chart[data-focus] .readout-item.is-focus,
  .latent-chart[data-focus] .legend-trigger.is-focus,
  .latent-chart[data-focus] .spark-trigger.is-focus,
  .latent-chart[data-focus] .end-label.is-focus {
    opacity: 1;
  }

  /* ── Rótulos de fim de linha ─────────────────────────────────────────────── */
  .end-label-connector {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.45;
  }
  .end-label-dot {
    fill: currentColor;
  }
  .end-label-name {
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums lining-nums;
    dominant-baseline: middle;
  }
  .end-label-val {
    fill: currentColor;
    opacity: 0.65;
  }
  .latent-chart[data-focus] .center-line.is-focus {
    stroke-width: 2.6;
  }

  /* Gatilhos de foco (legenda + sparkline): botões sem cara de botão. */
  .legend-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--rhythm);
    background: none;
    border: 0;
    padding: 2px 4px;
    margin: 0;
    border-radius: var(--radius-s);
    font: inherit;
    color: var(--ink);
    cursor: pointer;
  }
  .legend-trigger[aria-pressed='true'] {
    background: var(--surface);
  }
  .legend-trigger:focus-visible,
  .spark-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ── Mini-trajetórias (sparklines) ───────────────────────────────────────── */
  .sparklines {
    margin-top: calc(var(--rhythm) * 3);
  }
  .sparklines-title {
    color: var(--ink-3);
  }
  .sparkline-list {
    list-style: none;
    margin: calc(var(--rhythm) * 1.5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: var(--rhythm);
  }
  .spark-trigger {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'photo head'
      'photo spark';
    align-items: center;
    column-gap: var(--rhythm);
    row-gap: 2px;
    width: 100%;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-s);
    padding: calc(var(--rhythm) * 0.75) var(--rhythm);
    cursor: pointer;
    text-align: left;
    font: inherit;
  }
  .spark-trigger:hover,
  .spark-trigger[aria-pressed='true'] {
    border-color: color-mix(in srgb, currentColor 45%, transparent);
    background: var(--surface);
  }
  .spark-photo {
    grid-area: photo;
    display: inline-flex;
  }
  .spark-head {
    grid-area: head;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--rhythm);
    color: var(--ink);
  }
  .spark-name {
    font-family: var(--font-body);
    font-size: var(--fs-body-s);
  }
  .spark-val {
    font-family: var(--font-mono);
    font-size: var(--fs-body-s);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ink-2);
  }
  .spark-svg {
    grid-area: spark;
    width: 100%;
    height: 34px;
    display: block;
    overflow: visible;
  }

  /* ── Tooltip da linha (scrub-tip): foto + valor na data sob o cursor ──────── */
  .scrub-tip {
    position: absolute;
    top: 6px;
    left: 0;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 4;
    min-width: 150px;
    max-width: 240px;
    padding: calc(var(--rhythm) * 1.25);
    background: color-mix(in srgb, var(--bg-elevated) 92%, transparent);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-1);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .scrub-tip[data-open='true'] {
    opacity: 1;
  }
  .scrub-tip-date {
    margin: 0 0 var(--rhythm);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-3);
  }
  .scrub-tip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .scrub-tip-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--rhythm);
  }
  .scrub-tip-row.is-dim {
    display: none;
  }
  .scrub-tip-name {
    font-family: var(--font-body);
    font-size: var(--fs-body-s);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .scrub-tip-val {
    font-family: var(--font-mono);
    font-size: var(--fs-body-s);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ink);
  }
</style>

<script>
  import { updateUncertaintyRule } from './lib/rule-client.js';

  interface Sample {
    t: number;
    mean: number;
    lo90: number;
    hi90: number;
  }
  interface ClientSeries {
    candidateId: string;
    displayName: string;
    colorSlot: number;
    samples: Sample[];
  }
  interface PollMeta {
    tseId: string;
    instituteName: string;
    contractorName: string;
    contractorType: string;
    sampleSize: number;
    fieldStart: string;
    fieldEnd: string;
    values: Record<string, number>;
  }
  interface State {
    series: ClientSeries[];
    pollMeta: Record<string, PollMeta>;
    margins: { top: number; right: number; bottom: number; left: number };
    width: number;
    height: number;
    ruleDomain: [number, number];
    yDomain: [number, number];
  }

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');
  const nf1 = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const dm = new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: '2-digit',
    timeZone: 'America/Sao_Paulo',
  });

  function nearestSample(samples: Sample[], t: number): Sample | null {
    if (samples.length === 0) return null;
    let best = samples[0]!;
    let bestD = Math.abs(best.t - t);
    for (const s of samples) {
      const d = Math.abs(s.t - t);
      if (d < bestD) {
        best = s;
        bestD = d;
      }
    }
    return best;
  }

  function initChart(root: HTMLElement): void {
    const stateEl = root.querySelector<HTMLScriptElement>('[data-latent-state]');
    if (!stateEl?.textContent) return;
    const state = JSON.parse(stateEl.textContent) as State;
    const svg = root.querySelector('svg');
    if (!svg) return;

    const chartId = root.dataset.chartId ?? '';
    const { margins, width } = state;
    const innerLeft = margins.left;
    const innerRight = width - margins.right;
    const tMin = Math.min(...state.series.flatMap((s) => s.samples.map((p) => p.t)));
    const tMax = Math.max(...state.series.flatMap((s) => s.samples.map((p) => p.t)));
    const tSpan = tMax - tMin || 1;

    const xToT = (px: number): number =>
      tMin + ((px - innerLeft) / (innerRight - innerLeft)) * tSpan;
    const tToX = (t: number): number =>
      innerLeft + ((t - tMin) / tSpan) * (innerRight - innerLeft);

    // Valor (p.p.) → px vertical, para achar a LINHA mais próxima do cursor.
    const innerH = state.height - state.margins.top - state.margins.bottom;
    const ySpan = state.yDomain[1] - state.yDomain[0] || 1;
    const valueToPx = (v: number): number =>
      state.margins.top + (1 - (v - state.yDomain[0]) / ySpan) * innerH;

    const scrubLine = root.querySelector<SVGLineElement>('[data-scrub-line]');
    const readoutTitle = root.querySelector<HTMLElement>('.scrub-readout .label time');
    const scrubTip = root.querySelector<HTMLElement>('[data-scrub-tip]');
    const scrubTipDate = root.querySelector<HTMLElement>('[data-scrub-tip-date]');

    // Orquestração de load: adiciona a classe que dispara as animações CSS
    // (bandas → linhas → pontos). Sob reduced-motion o CSS já ignora.
    requestAnimationFrame(() => root.classList.add('chart-animate'));

    function setReadoutForT(t: number): void {
      if (readoutTitle) {
        readoutTitle.textContent = dm.format(new Date(t));
      }
      if (scrubTipDate) {
        scrubTipDate.textContent = dm.format(new Date(t));
      }
      for (const s of state.series) {
        const sample = nearestSample(s.samples, t);
        if (!sample) continue;
        // Tooltip da linha: valor do candidato na data sob o cursor (com a foto
        // pré-renderizada ao lado). Some quando não há JS; segue o foco.
        const tipVal = root.querySelector<HTMLElement>(
          `[data-scrub-tip-val][data-candidate="${CSS.escape(s.candidateId)}"]`,
        );
        if (tipVal) tipVal.textContent = `${nf1.format(sample.mean)}%`;
        const numEl = root.querySelector<HTMLElement>(
          `[data-readout-num][data-candidate="${CSS.escape(s.candidateId)}"]`,
        );
        // O <AnimatedNum> é o irmão anterior do tag; movemos o data-target dele.
        const animated = numEl?.previousElementSibling as HTMLElement | null;
        if (animated?.hasAttribute('data-animated-num')) {
          animated.setAttribute('data-target', String(sample.mean));
        }
        const ruleWrap = root.querySelector(
          `[data-rule-for="${CSS.escape(s.candidateId)}"] [data-uncertainty-rule]`,
        );
        if (ruleWrap) {
          updateUncertaintyRule(ruleWrap as SVGElement, {
            mean: sample.mean,
            lo90: sample.lo90,
            hi90: sample.hi90,
          });
        }
      }
    }

    function moveScrubTo(px: number): void {
      const clamped = Math.max(innerLeft, Math.min(innerRight, px));
      if (scrubLine) {
        scrubLine.setAttribute('x1', String(clamped));
        scrubLine.setAttribute('x2', String(clamped));
      }
      if (scrubTip) {
        const box = svg!.getBoundingClientRect();
        scrubTip.style.left = `${(clamped / width) * box.width}px`;
        scrubTip.dataset.open = 'true';
        scrubTip.setAttribute('aria-hidden', 'false');
      }
      root.classList.add('is-scrubbing');
      setReadoutForT(xToT(clamped));
    }

    function hideScrubTip(): void {
      if (!scrubTip) return;
      scrubTip.dataset.open = 'false';
      scrubTip.setAttribute('aria-hidden', 'true');
    }

    const hit = root.querySelector<SVGRectElement>('[data-scrub-hit]');
    const rectPx = (evt: MouseEvent): number => {
      const box = svg!.getBoundingClientRect();
      const scale = width / box.width;
      return (evt.clientX - box.left) * scale;
    };
    hit?.addEventListener('mousemove', (e) => {
      const ev = e as MouseEvent;
      const px = rectPx(ev);
      moveScrubTo(px);
      // Identifica a LINHA mais próxima do cursor e a coloca em foco: passar o
      // mouse "numa linha" passa a dizer QUEM é (a queixa central).
      const box = svg!.getBoundingClientRect();
      const cy = (ev.clientY - box.top) * (state.height / box.height);
      const t = xToT(Math.max(innerLeft, Math.min(innerRight, px)));
      let nearest: string | null = null;
      let best = Infinity;
      for (const s of state.series) {
        const samp = nearestSample(s.samples, t);
        if (!samp) continue;
        const d = Math.abs(valueToPx(samp.mean) - cy);
        if (d < best) {
          best = d;
          nearest = s.candidateId;
        }
      }
      applyFocus(nearest ?? pinnedCandidate);
    });
    hit?.addEventListener('mouseleave', () => {
      root.classList.remove('is-scrubbing');
      hideScrubTip();
      // Restaura o valor "de agora" (última data) e o foco fixado, se houver.
      setReadoutForT(tMax);
      applyFocus(pinnedCandidate);
    });

    // Teclado no scrub: setas movem por amostra.
    let scrubIndex = (state.series[0]?.samples.length ?? 1) - 1;
    const baseSamples = state.series[0]?.samples ?? [];
    hit?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key === 'ArrowRight' || ev.key === 'ArrowUp') {
        scrubIndex = Math.min(baseSamples.length - 1, scrubIndex + 1);
      } else if (ev.key === 'ArrowLeft' || ev.key === 'ArrowDown') {
        scrubIndex = Math.max(0, scrubIndex - 1);
      } else if (ev.key === 'Home') {
        scrubIndex = 0;
      } else if (ev.key === 'End') {
        scrubIndex = baseSamples.length - 1;
      } else {
        return;
      }
      ev.preventDefault();
      const t = baseSamples[scrubIndex]?.t ?? tMax;
      moveScrubTo(tToX(t));
      hit?.setAttribute('aria-valuenow', String(t));
    });

    // ── Tooltip por hover/foco de ponto, navegável por teclado ──
    const tooltip = root.querySelector<HTMLElement>('[data-tooltip]');
    const pointEls = Array.from(root.querySelectorAll<SVGCircleElement>('[data-poll-point]'));

    function tooltipHtml(tseId: string): string {
      const meta = state.pollMeta[tseId];
      if (!meta) return `<strong class="tt-mono">${tseId}</strong>`;
      const rows = Object.entries(meta.values)
        .map(([cid, v]) => {
          const name = state.series.find((s) => s.candidateId === cid)?.displayName ?? cid;
          return `<dt>${name}</dt><dd>${nf1.format(v)}%</dd>`;
        })
        .join('');
      const field = `${dm.format(fieldMs(meta.fieldStart))}–${dm.format(fieldMs(meta.fieldEnd))}`;
      return `
        <dl>
          <dt>Instituto</dt><dd>${meta.instituteName}</dd>
          <dt>Contratante</dt><dd>${meta.contractorName} (${meta.contractorType})</dd>
          <dt>Registro TSE</dt><dd class="tt-mono">${meta.tseId}</dd>
          <dt>Amostra</dt><dd class="tt-mono">n = ${meta.sampleSize}</dd>
          <dt>Campo</dt><dd class="tt-mono">${field}</dd>
          ${rows}
        </dl>`;
    }

    function fieldMs(iso: string): Date {
      return new Date(`${iso.slice(0, 10)}T00:00:00-03:00`);
    }

    function showTooltip(el: SVGCircleElement): void {
      if (!tooltip) return;
      const tseId = el.dataset.tseId ?? '';
      tooltip.innerHTML = tooltipHtml(tseId);
      tooltip.setAttribute('data-open', 'true');
      tooltip.setAttribute('aria-hidden', 'false');
      const cx = Number(el.getAttribute('cx'));
      const cy = Number(el.getAttribute('cy'));
      const box = svg!.getBoundingClientRect();
      const scaleX = box.width / width;
      const scaleY = box.height / state.height;
      tooltip.style.left = `${cx * scaleX + 12}px`;
      tooltip.style.top = `${cy * scaleY - 8}px`;
      pointEls.forEach((p) => p.classList.remove('is-active'));
      el.classList.add('is-active');
    }

    function hideTooltip(): void {
      if (!tooltip) return;
      tooltip.setAttribute('data-open', 'false');
      tooltip.setAttribute('aria-hidden', 'true');
      pointEls.forEach((p) => p.classList.remove('is-active'));
    }

    pointEls.forEach((el, i) => {
      el.addEventListener('mouseenter', () => showTooltip(el));
      el.addEventListener('mouseleave', hideTooltip);
      el.addEventListener('focus', () => showTooltip(el));
      el.addEventListener('blur', hideTooltip);
      el.addEventListener('keydown', (e) => {
        const ev = e as KeyboardEvent;
        if (ev.key === 'Escape') {
          hideTooltip();
          el.blur();
        } else if (ev.key === 'ArrowRight' || ev.key === 'ArrowDown') {
          ev.preventDefault();
          pointEls[Math.min(pointEls.length - 1, i + 1)]?.focus();
        } else if (ev.key === 'ArrowLeft' || ev.key === 'ArrowUp') {
          ev.preventDefault();
          pointEls[Math.max(0, i - 1)]?.focus();
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideTooltip();
    });

    // ── Foco interativo: isola um candidato (banda, linha, readout, legenda,
    // sparkline e a linha do scrub-tip). Hover/foco realça temporariamente; clique
    // fixa; Esc solta. Sem JS o gráfico mostra tudo — o foco é enriquecimento. ──
    const focusTriggers = Array.from(root.querySelectorAll<HTMLElement>('[data-focus-trigger]'));
    const focusMarked = Array.from(
      root.querySelectorAll<Element>(
        '.band-group,[data-center],.readout-item,[data-focus-trigger],[data-scrub-tip-row],.end-label',
      ),
    );
    let pinnedCandidate: string | null = null;

    function applyFocus(cid: string | null): void {
      if (cid) root.setAttribute('data-focus', '');
      else root.removeAttribute('data-focus');
      for (const el of focusMarked) {
        const match = el.getAttribute('data-candidate') === cid;
        el.classList.toggle('is-focus', cid !== null && match);
        if (el.hasAttribute('data-scrub-tip-row')) {
          el.classList.toggle('is-dim', cid !== null && !match);
        }
      }
      for (const t of focusTriggers) {
        t.setAttribute(
          'aria-pressed',
          String(pinnedCandidate !== null && t.dataset.candidate === pinnedCandidate),
        );
      }
    }

    // Hover/foco mostra a série apontada; se algo está fixado, ela prevalece ao sair.
    function hoverFocus(cid: string | null): void {
      applyFocus(cid ?? pinnedCandidate);
    }

    for (const t of focusTriggers) {
      const cid = t.dataset.candidate ?? null;
      t.addEventListener('mouseenter', () => hoverFocus(cid));
      t.addEventListener('mouseleave', () => hoverFocus(null));
      t.addEventListener('focus', () => hoverFocus(cid));
      t.addEventListener('blur', () => hoverFocus(null));
      t.addEventListener('click', () => {
        pinnedCandidate = pinnedCandidate === cid ? null : cid;
        applyFocus(pinnedCandidate);
      });
    }
    root.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && pinnedCandidate !== null) {
        pinnedCandidate = null;
        applyFocus(null);
      }
    });

    // ── Transição de atualização (novo run): banda + números interpolam ──
    // Exposta para T-12 chamar ao republicar. Reusa o mesmo caminho de scrub.
    interface UpdatePayload {
      series: ClientSeries[];
    }
    const globalKey = '__latentUpdate';
    const w = window as unknown as Record<string, unknown>;
    const prev = (w[globalKey] as ((id: string, p: UpdatePayload) => void) | undefined) ?? null;
    w[globalKey] = (id: string, payload: UpdatePayload): void => {
      if (prev) prev(id, payload);
      if (id !== chartId) return;
      state.series = payload.series;
      // Anima readouts + réguas ao novo "agora" (última data).
      setReadoutForT(Math.max(...payload.series.flatMap((s) => s.samples.map((p) => p.t))));
    };

    void REDUCED; // reduced-motion é tratado pelo CSS (animações e transições).
  }

  document
    .querySelectorAll<HTMLElement>('[data-latent-chart]')
    .forEach((el) => initChart(el));
</script>
