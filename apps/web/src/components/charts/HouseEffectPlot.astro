---
/**
 * <HouseEffectPlot> — dot plot com IC 90% por instituto (docs/05 §5).
 *
 * Eixo centrado em ZERO, enfatizado (a linha do consenso). Cada linha = um par
 * (instituto, candidato): ponto no efeito estimado + barra de IC 90%. Cor segue
 * a entidade (colorSlot do candidato). `estimable: false` aparece ESMAECIDO com
 * "—" (nunca um número inventado — R4).
 *
 * SSR-completo: o SVG é o estado final. A hidratação só acrescenta o tooltip de
 * hover/foco (client:visible na página).
 *
 * Restrição de leitura (docs/06 §5): a seção que embrulha isto explica o que o
 * número significa E o que não (restrição soma-zero). Aqui só desenhamos.
 */
import Num from '../Num.astro';
import HachuraDefs from './HachuraDefs.astro';
import { formatPct } from './lib/format.js';
import './lib/charts.css';

export interface HouseEffectRow {
  instituteId: string;
  instituteName: string;
  candidateId: string;
  candidateName: string;
  colorSlot: number;
  effect: number;
  lo90: number;
  hi90: number;
  nPolls: number;
  estimable: boolean;
}

interface Props {
  rows: HouseEffectRow[];
  title: string;
  id: string;
  width?: number;
  class?: string | undefined;
}

const { rows, title, id, width = 720, class: className } = Astro.props;

const ROW_H = 28;
const margins = { top: 24, right: 24, bottom: 28, left: 180 };
const innerWidth = width - margins.left - margins.right;
const height = margins.top + margins.bottom + rows.length * ROW_H;

// Domínio simétrico em torno de zero, cobrindo o maior extremo estimável.
const extremes = rows
  .filter((r) => r.estimable)
  .flatMap((r) => [Math.abs(r.lo90), Math.abs(r.hi90), Math.abs(r.effect)]);
const maxAbs = Math.max(3, Math.ceil(Math.max(0, ...extremes)));
const x = (v: number): number =>
  margins.left + ((v + maxAbs) / (2 * maxAbs)) * innerWidth;
const zeroX = x(0);

const slots = [...new Set(rows.map((r) => r.colorSlot))];

// Ticks simétricos em passos inteiros.
const tickStep = maxAbs <= 4 ? 1 : 2;
const ticks: number[] = [];
for (let v = -maxAbs; v <= maxAbs; v += tickStep) ticks.push(v);

const descRows = rows.map((r) =>
  r.estimable
    ? `${r.instituteName}/${r.candidateName}: ${formatPct(r.effect)} p.p. (IC90 ${formatPct(
        r.lo90,
      )} a ${formatPct(r.hi90)}, ${r.nPolls} pesquisas)`
    : `${r.instituteName}/${r.candidateName}: não estimável`,
);
const desc = `Desvio sistemático de cada instituto em relação ao consenso, por candidato, com intervalo de 90%. Zero é o consenso. ${descRows.join(
  '; ',
)}.`;
---

<figure class:list={['chart house-effect', className]} data-house-effect data-chart-id={id}>
  <figcaption class="label">{title}</figcaption>

  <div class="chart-plot">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-labelledby={`${id}-title ${id}-desc`}
      preserveAspectRatio="xMidYMid meet"
    >
      <title id={`${id}-title`}>{title}</title>
      <desc id={`${id}-desc`}>{desc}</desc>
      <defs>
        <HachuraDefs idPrefix={id} slots={slots} />
      </defs>

      {/* Ticks do eixo. */}
      <g aria-hidden="true">
        {
          ticks.map((t) => (
            <g>
              <line
                class="axis-tick"
                x1={x(t)}
                y1={margins.top - 6}
                x2={x(t)}
                y2={height - margins.bottom}
              />
              <text
                class="axis-label"
                x={x(t)}
                y={height - margins.bottom + 16}
                text-anchor="middle"
              >
                {t > 0 ? `+${t}` : `${t}`}
              </text>
            </g>
          ))
        }
        {/* Zero enfatizado — a linha do consenso. */}
        <line class="zero-line" x1={zeroX} y1={margins.top - 6} x2={zeroX} y2={height - margins.bottom}></line>
      </g>

      {/* Uma linha por (instituto, candidato). */}
      {
        rows.map((r, i) => {
          const cy = margins.top + i * ROW_H + ROW_H / 2;
          return (
            <g
              class:list={['effect-row', { 'not-estimable': !r.estimable }]}
              style={`color: var(--c${r.colorSlot})`}
              data-effect-row
              data-institute={r.instituteId}
              data-candidate={r.candidateId}
              tabindex="0"
              role="button"
              aria-label={
                r.estimable
                  ? `${r.instituteName}, ${r.candidateName}: efeito ${formatPct(r.effect)} pontos`
                  : `${r.instituteName}, ${r.candidateName}: não estimável`
              }
            >
              <text class="row-label" x={margins.left - 12} y={cy + 4} text-anchor="end">
                {r.instituteName} · {r.candidateName}
              </text>
              {r.estimable ? (
                <>
                  <line class="ci-bar" x1={x(r.lo90)} y1={cy} x2={x(r.hi90)} y2={cy} stroke="currentColor" />
                  <circle class="effect-dot" cx={x(r.effect)} cy={cy} r={5} fill="currentColor" />
                </>
              ) : (
                <text class="not-estimable-mark" x={zeroX} y={cy + 5} text-anchor="middle">
                  —
                </text>
              )}
            </g>
          );
        })
      }
    </svg>
    <div class="chart-tooltip" data-tooltip role="tooltip" aria-hidden="true"></div>
  </div>

  {/* Equivalente textual (docs/05 §7). */}
  <details class="chart-table">
    <summary>Ver house effects em tabela</summary>
    <table>
      <caption>
        Desvio sistemático em relação ao consenso, por instituto e candidato, com intervalo de <Num
          >90</Num
        >%. Valores em pontos percentuais.
      </caption>
      <thead>
        <tr>
          <th scope="col">Instituto</th>
          <th scope="col">Candidato</th>
          <th class="num" scope="col">Efeito</th>
          <th class="num" scope="col">IC <Num>90</Num>%</th>
          <th class="num" scope="col">Pesquisas</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td>{r.instituteName}</td>
              <td>{r.candidateName}</td>
              <td class="num">
                {r.estimable ? <Num>{formatPct(r.effect)}</Num> : <Num>—</Num>}
              </td>
              <td class="num">
                {r.estimable ? (
                  <>
                    <Num>{formatPct(r.lo90)}</Num>–<Num>{formatPct(r.hi90)}</Num>
                  </>
                ) : (
                  <Num>—</Num>
                )}
              </td>
              <td class="num">
                <Num>{String(r.nPolls)}</Num>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>

  <script
    is:inline
    type="application/json"
    data-house-state
    set:html={JSON.stringify({ rows })}
  />
</figure>

<script>
  interface Row {
    instituteId: string;
    instituteName: string;
    candidateId: string;
    candidateName: string;
    colorSlot: number;
    effect: number;
    lo90: number;
    hi90: number;
    nPolls: number;
    estimable: boolean;
  }

  const nf1 = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

  function init(root: HTMLElement): void {
    const stateEl = root.querySelector<HTMLScriptElement>('[data-house-state]');
    const svg = root.querySelector('svg');
    const tooltip = root.querySelector<HTMLElement>('[data-tooltip]');
    if (!stateEl?.textContent || !svg || !tooltip) return;
    const { rows } = JSON.parse(stateEl.textContent) as { rows: Row[] };
    const byKey = new Map(rows.map((r) => [`${r.instituteId}|${r.candidateId}`, r]));

    function html(r: Row): string {
      if (!r.estimable) {
        return `<dl><dt>Instituto</dt><dd>${r.instituteName}</dd><dt>Candidato</dt><dd>${r.candidateName}</dd><dt>Situação</dt><dd>não estimável (n insuficiente)</dd></dl>`;
      }
      return `<dl>
        <dt>Instituto</dt><dd>${r.instituteName}</dd>
        <dt>Candidato</dt><dd>${r.candidateName}</dd>
        <dt>Efeito</dt><dd class="tt-mono">${nf1.format(r.effect)} p.p.</dd>
        <dt>IC 90%</dt><dd class="tt-mono">${nf1.format(r.lo90)} a ${nf1.format(r.hi90)}</dd>
        <dt>Pesquisas</dt><dd class="tt-mono">${r.nPolls}</dd>
      </dl>`;
    }

    const groups = Array.from(root.querySelectorAll<SVGGElement>('[data-effect-row]'));
    function show(g: SVGGElement): void {
      const key = `${g.dataset.institute}|${g.dataset.candidate}`;
      const r = byKey.get(key);
      if (!r || !tooltip) return;
      tooltip.innerHTML = html(r);
      tooltip.setAttribute('data-open', 'true');
      tooltip.setAttribute('aria-hidden', 'false');
      const box = g.getBoundingClientRect();
      const rootBox = root.getBoundingClientRect();
      tooltip.style.left = `${box.left - rootBox.left + box.width / 2}px`;
      tooltip.style.top = `${box.top - rootBox.top}px`;
    }
    function hide(): void {
      tooltip?.setAttribute('data-open', 'false');
      tooltip?.setAttribute('aria-hidden', 'true');
    }
    groups.forEach((g) => {
      g.addEventListener('mouseenter', () => show(g));
      g.addEventListener('mouseleave', hide);
      g.addEventListener('focus', () => show(g));
      g.addEventListener('blur', hide);
      g.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          hide();
          g.blur();
        }
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hide();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-house-effect]').forEach((el) => init(el));
</script>
