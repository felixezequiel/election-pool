---
/**
 * <HouseEffectPlot> — desvio sistemático de cada instituto em relação ao consenso,
 * AGRUPADO POR CANDIDATO (docs/05 §5, docs/06 §5).
 *
 * Duas decisões vêm de feedback direto:
 *  1. O NÚMERO fica à vista, não no tooltip: cada linha diz "+0,8 acima" / "−0,6
 *     abaixo", ao lado da barra. Ponto sem número não se lê (docs/06 §5).
 *  2. Agrupado por candidato (cor do candidato), institutos ordenados por desvio.
 *     Passar o cursor num instituto o realça em TODOS os candidatos — é assim que
 *     o viés SISTEMÁTICO de uma casa aparece: o mesmo instituto puxando para o
 *     mesmo lado em vários candidatos.
 *
 * Escala ÚNICA entre todos os grupos: os desvios só são comparáveis se o mesmo
 * deslocamento em p.p. for a mesma distância na tela. Zero é o consenso, marcado
 * forte. `estimable: false` aparece com "—" (nunca número inventado, R4).
 *
 * SSR-completo: as barras já vêm posicionadas (percentuais calculados aqui). O JS
 * só adiciona o realce de instituto. A tabela é o equivalente textual (docs/05 §7).
 */
import CandidatePhoto from '../CandidatePhoto.astro';
import Num from '../Num.astro';
import { formatPct } from './lib/format.js';

export interface HouseEffectRow {
  instituteId: string;
  instituteName: string;
  candidateId: string;
  candidateName: string;
  colorSlot: number;
  /** Foto oficial do candidato (cabeçalho do grupo); null ⇒ monograma. */
  photoPath: string | null;
  effect: number;
  lo90: number;
  hi90: number;
  nPolls: number;
  estimable: boolean;
}

interface Props {
  rows: HouseEffectRow[];
  title: string;
  id: string;
  /** Ordem de exibição dos candidatos (ids em voto decrescente). Fallback: colorSlot. */
  candidateOrder?: string[];
  class?: string | undefined;
}

const { rows, title, id, candidateOrder = [], class: className } = Astro.props;

// Escala simétrica única, cobrindo o maior extremo estimável (mínimo ±3 p.p.).
const extremes = rows
  .filter((r) => r.estimable)
  .flatMap((r) => [Math.abs(r.lo90), Math.abs(r.hi90), Math.abs(r.effect)]);
const maxAbs = Math.max(3, Math.ceil(Math.max(0, ...extremes)));
/** Posição de um valor p.p. na faixa 0–100% (0 p.p. = 50%). */
const pos = (v: number): number => Math.max(0, Math.min(100, ((v + maxAbs) / (2 * maxAbs)) * 100));

/** Abaixo disto tratamos como "no consenso" para o rótulo textual. */
const CONSENSUS_EPS = 0.05;
function direction(effect: number): 'acima' | 'abaixo' | 'no consenso' {
  if (effect > CONSENSUS_EPS) return 'acima';
  if (effect < -CONSENSUS_EPS) return 'abaixo';
  return 'no consenso';
}
function signed(v: number): string {
  const s = formatPct(Math.abs(v));
  if (v > CONSENSUS_EPS) return `+${s}`;
  if (v < -CONSENSUS_EPS) return `−${s}`;
  return '0,0';
}

// Agrupa por candidato; ordena grupos por voto (candidateOrder) e institutos por
// desvio (mais acima primeiro), com os não-estimáveis por último.
interface Group {
  candidateId: string;
  candidateName: string;
  colorSlot: number;
  photoPath: string | null;
  rows: HouseEffectRow[];
}
const groupsMap = new Map<string, Group>();
for (const r of rows) {
  let g = groupsMap.get(r.candidateId);
  if (!g) {
    g = {
      candidateId: r.candidateId,
      candidateName: r.candidateName,
      colorSlot: r.colorSlot,
      photoPath: r.photoPath,
      rows: [],
    };
    groupsMap.set(r.candidateId, g);
  }
  g.rows.push(r);
}
const orderIndex = (cid: string): number => {
  const i = candidateOrder.indexOf(cid);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};
const groups = [...groupsMap.values()].sort((a, b) => {
  const oa = orderIndex(a.candidateId);
  const ob = orderIndex(b.candidateId);
  if (oa !== ob) return oa - ob;
  return a.colorSlot - b.colorSlot;
});
for (const g of groups) {
  g.rows.sort((a, b) => {
    if (a.estimable !== b.estimable) return a.estimable ? -1 : 1;
    return b.effect - a.effect;
  });
}

const desc = `Desvio sistemático de cada instituto em relação ao consenso, agrupado por candidato, com intervalo de 90%. Zero é o consenso. ${groups
  .map(
    (g) =>
      `${g.candidateName}: ` +
      g.rows
        .map((r) =>
          r.estimable
            ? `${r.instituteName} ${formatPct(r.effect)} p.p.`
            : `${r.instituteName} não estimável`,
        )
        .join(', '),
  )
  .join('; ')}.`;
---

<figure class:list={['house-effect', className]} data-house-effect data-chart-id={id}>
  <figcaption class="label">{title}</figcaption>
  <p class="sr-only">{desc}</p>

  {/* Chave do eixo, alinhada à coluna da barra (docs/06 §5). */}
  <div class="he-axis" aria-hidden="true">
    <span class="he-axis-name" />
    <span class="he-axis-track">
      <span class="he-axis-left">◀ abaixo do consenso</span>
      <span class="he-axis-zero-label"><Num>0</Num></span>
      <span class="he-axis-right">acima do consenso ▶</span>
    </span>
    <span class="he-axis-val">desvio · faixa <Num>90</Num>%</span>
  </div>

  {
    groups.map((g) => (
      <section class="he-group" data-candidate={g.candidateId} style={`color: var(--c${g.colorSlot})`}>
        <h3 class="he-group-head">
          <CandidatePhoto
            photoPath={g.photoPath}
            displayName={g.candidateName}
            colorSlot={g.colorSlot}
            size={24}
          />
          <span class="he-group-name">{g.candidateName}</span>
        </h3>
        <ul class="he-rows">
          {g.rows.map((r) => (
            <li class="he-row" data-row data-institute={r.instituteId}>
              <button
                type="button"
                class="he-rowbtn"
                data-institute-trigger
                data-institute={r.instituteId}
                aria-pressed="false"
                aria-label={
                  r.estimable
                    ? `${r.instituteName}, ${r.candidateName}: ${formatPct(r.effect)} pontos ${direction(r.effect)} do consenso, faixa de 90 por cento de ${formatPct(r.lo90)} a ${formatPct(r.hi90)}, ${r.nPolls} pesquisas. Realçar este instituto.`
                    : `${r.instituteName}, ${r.candidateName}: não estimável, menos de 3 pesquisas.`
                }
              >
                <span class="he-inst">{r.instituteName}</span>
                <span class="he-track">
                  <span class="he-zero" />
                  {r.estimable ? (
                    <>
                      <span
                        class="he-range"
                        style={`left:${pos(r.lo90)}%;right:${100 - pos(r.hi90)}%`}
                      />
                      <span class="he-dot" style={`left:${pos(r.effect)}%`} />
                    </>
                  ) : (
                    <span class="he-na">n&nbsp;&lt;&nbsp;3</span>
                  )}
                </span>
                <span class="he-val">
                  {r.estimable ? (
                    <>
                      <span class="he-num">
                        <Num>{signed(r.effect)}</Num>
                      </span>
                      <span class="he-dir">{direction(r.effect)}</span>
                    </>
                  ) : (
                    <span class="he-dir he-dir-na">—</span>
                  )}
                </span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {/* Equivalente textual (docs/05 §7). */}
  <details class="chart-table">
    <summary>Ver house effects em tabela</summary>
    <table>
      <caption>
        Desvio sistemático em relação ao consenso, por instituto e candidato, com intervalo de <Num
          >90</Num
        >%. Valores em pontos percentuais.
      </caption>
      <thead>
        <tr>
          <th scope="col">Candidato</th>
          <th scope="col">Instituto</th>
          <th class="num" scope="col">Efeito</th>
          <th class="num" scope="col">IC <Num>90</Num>%</th>
          <th class="num" scope="col">Pesquisas</th>
        </tr>
      </thead>
      <tbody>
        {
          groups.flatMap((g) =>
            g.rows.map((r) => (
              <tr>
                <td>{r.candidateName}</td>
                <td>{r.instituteName}</td>
                <td class="num">{r.estimable ? <Num>{formatPct(r.effect)}</Num> : <Num>—</Num>}</td>
                <td class="num">
                  {r.estimable ? (
                    <>
                      <Num>{formatPct(r.lo90)}</Num>–<Num>{formatPct(r.hi90)}</Num>
                    </>
                  ) : (
                    <Num>—</Num>
                  )}
                </td>
                <td class="num">
                  <Num>{String(r.nPolls)}</Num>
                </td>
              </tr>
            )),
          )
        }
      </tbody>
    </table>
  </details>
</figure>

<style>
  .house-effect {
    margin: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Grade compartilhada: nome | barra | valor. Eixo e linhas usam as MESMAS
     colunas para o zero e a escala baterem entre todos os grupos. */
  .he-axis,
  .he-rowbtn {
    display: grid;
    grid-template-columns: minmax(96px, 168px) minmax(0, 1fr) minmax(104px, auto);
    align-items: center;
    gap: var(--gutter);
  }
  .he-axis {
    margin-top: calc(var(--rhythm) * 2);
    padding-bottom: var(--rhythm);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-3);
  }
  .he-axis-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }
  .he-axis-zero-label {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ink-2);
  }
  .he-axis-val {
    text-align: right;
  }

  .he-group {
    margin-top: calc(var(--rhythm) * 3);
  }
  .he-group-head {
    display: flex;
    align-items: center;
    gap: var(--rhythm);
    margin: 0 0 var(--rhythm);
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    font-weight: 600;
    color: var(--ink);
  }
  .he-group-name {
    color: var(--ink);
  }
  .he-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .he-row + .he-row {
    border-top: 1px solid var(--border);
  }
  .he-rowbtn {
    width: 100%;
    background: none;
    border: 0;
    padding: calc(var(--rhythm) * 1) 0;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: var(--ink);
    border-radius: var(--radius-s);
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .he-rowbtn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .he-inst {
    font-family: var(--font-body);
    font-size: var(--fs-body-s);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Barra: zero no meio, faixa 90% em currentColor, ponto no efeito. */
  .he-track {
    position: relative;
    height: 20px;
    min-width: 120px;
  }
  .he-zero {
    position: absolute;
    left: 50%;
    top: -2px;
    bottom: -2px;
    width: 1px;
    background: var(--border-strong);
  }
  .he-range {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 6px;
    border-radius: 3px;
    background: color-mix(in srgb, currentColor 30%, transparent);
  }
  .he-dot {
    position: absolute;
    top: 50%;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px var(--bg);
  }
  .he-na {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-3);
    white-space: nowrap;
  }

  .he-val {
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
    justify-content: flex-end;
    text-align: right;
  }
  .he-num {
    font-family: var(--font-mono);
    font-size: var(--fs-data);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ink);
  }
  .he-dir {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-3);
  }

  /* Realce de instituto: o instituto apontado fica; os demais recuam — em todos os
     candidatos. É onde o viés sistemático de uma casa aparece. */
  .house-effect[data-hl] .he-row:not(.is-hl) .he-rowbtn {
    opacity: 0.22;
  }
  .house-effect[data-hl] .he-row.is-hl .he-rowbtn {
    background: var(--surface);
  }

  @media (max-width: 640px) {
    .he-axis,
    .he-rowbtn {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'inst val'
        'track track';
      gap: var(--rhythm) var(--gutter);
    }
    .he-axis-name,
    .he-axis-track {
      display: none;
    }
    .he-inst {
      grid-area: inst;
    }
    .he-val {
      grid-area: val;
    }
    .he-track {
      grid-area: track;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .he-rowbtn {
      transition: none;
    }
  }
</style>

<script>
  function init(root: HTMLElement): void {
    const triggers = Array.from(root.querySelectorAll<HTMLElement>('[data-institute-trigger]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-row]'));
    let pinned: string | null = null;

    function apply(inst: string | null): void {
      if (inst) root.setAttribute('data-hl', '');
      else root.removeAttribute('data-hl');
      rows.forEach((r) => r.classList.toggle('is-hl', inst !== null && r.dataset.institute === inst));
      triggers.forEach((t) =>
        t.setAttribute('aria-pressed', String(pinned !== null && t.dataset.institute === pinned)),
      );
    }

    triggers.forEach((t) => {
      const inst = t.dataset.institute ?? null;
      t.addEventListener('mouseenter', () => apply(inst ?? pinned));
      t.addEventListener('mouseleave', () => apply(pinned));
      t.addEventListener('focus', () => apply(inst ?? pinned));
      t.addEventListener('blur', () => apply(pinned));
      t.addEventListener('click', () => {
        pinned = pinned === inst ? null : inst;
        apply(pinned);
      });
    });
    root.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && pinned) {
        pinned = null;
        apply(null);
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-house-effect]').forEach((el) => init(el));
</script>
