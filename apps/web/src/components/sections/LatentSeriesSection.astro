---
/**
 * Seção 03 — SÉRIE LATENTE (docs/06 §2). 1º turno, bleed 12 colunas: bandas
 * dominantes, pontos das pesquisas por trás. O gráfico é o protagonista; o texto
 * é comentário (docs/05 §4). SSR-completo: o SVG já aparece sem JS.
 */
import LatentBandChart from '../charts/LatentBandChart.astro';
import ElectorateSeriesChart from '../charts/ElectorateSeriesChart.astro';
import Num from '../Num.astro';
import type { ChartInputs } from '../../data/chart-inputs.js';

interface Props {
  firstRound: ChartInputs['firstRound'];
  /** Branco/nulo e não-sabe (MODEL_VERSION 2.0.0) — mesma seção, mesmo eixo. */
  electorate: ChartInputs['electorate'];
}

const { firstRound, electorate } = Astro.props;
const hasSeries = firstRound.series.length > 0;

/**
 * As grandezas do eleitorado entram na MESMA seção da série de candidatos, logo
 * abaixo e no MESMO eixo do tempo (`xDomain` da série de 1º turno). Ficam juntas
 * porque a leitura é conjunta — o que sai de um candidato costuma ir para o
 * branco/nulo ou para o não-sabe —, mas em outro gráfico e com identidade visual
 * neutra, porque não são candidatura e não disputam a mesma leitura.
 */
const hasElectorate = electorate.some((s) => s.points.some((p) => p.band !== null));
---

<section class="section" aria-labelledby="latent-title">
  <div class="container">
    <p class="label">Série de apoio estimado</p>
    <h2 id="latent-title" class="display-l latent-heading">
      A banda é o dado. A linha central é secundária.
    </h2>
    <p class="body latent-lead">
      Cada faixa é o intervalo de <Num>90</Num>% do apoio estimado ao longo do tempo; a linha
      discreta é a média. Os pontos por trás são as pesquisas individuais que alimentam a
      estimativa.
    </p>
  </div>

  {
    hasSeries ? (
      <div class="bleed substrate-plot latent-plot">
        <div class="bleed-inner">
          <LatentBandChart
            id="latent-first"
            title="Primeiro turno — série de apoio estimado, últimos 90 dias"
            series={firstRound.series}
            points={firstRound.points}
            pollMeta={firstRound.pollMeta}
          />

          {hasElectorate && (
            <div class="elec-block">
              <h3 class="display-m elec-heading">Quem não está com ninguém.</h3>
              <p class="body elec-lead">
                Branco e nulo e não-sabe são estados do eleitorado com a mesma dignidade de um
                candidato: é deles que sai, e para eles que vai, boa parte do movimento. Não são
                candidatura, então não recebem cor do espectro — e onde a grandeza não foi
                medida, a faixa é interrompida em vez de virar zero.
              </p>
              <ElectorateSeriesChart
                id="electorate-first"
                title="Branco e nulo e não-sabe — estimativa ao longo do tempo"
                series={electorate}
                xDomain={firstRound.xDomain}
              />
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="container">
        <p class="body-muted latent-empty">
          Ainda não há série estimada para exibir. Assim que houver pesquisas na janela, a banda
          aparece aqui.
        </p>
      </div>
    )
  }
</section>

<style>
  .latent-heading {
    margin-top: calc(var(--rhythm) * 1.5);
    max-width: 24ch;
  }
  .latent-lead {
    margin-top: calc(var(--rhythm) * 2);
    max-width: 62ch;
  }
  .latent-plot {
    margin-top: calc(var(--rhythm) * 4);
  }
  .latent-empty {
    margin-top: calc(var(--rhythm) * 3);
    max-width: 60ch;
  }
  .elec-block {
    margin-top: calc(var(--rhythm) * 6);
    padding-top: calc(var(--rhythm) * 4);
    border-top: 1px solid var(--border);
  }
  .elec-lead {
    margin-top: calc(var(--rhythm) * 2);
    max-width: 64ch;
  }
</style>
