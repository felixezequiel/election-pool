# Copie para `.env` e ajuste o que quiser. NÃO há segredo aqui — é uma stack de
# desenvolvimento local. No Windows use `Copy-Item .env.example .env` (o `Out-File`
# grava BOM UTF-8 e o BOM corrompe o nome da primeira variável).
#
#   docker compose up          # sobe postgres + api + nginx
#   http://localhost:8080      # o site
#   http://localhost:8081/health   # saúde interna da api

# ─── Postgres compartilhado (container `dev-postgres`) ────────────────────────
# Um servidor Postgres para TODOS os projetos de desenvolvimento da máquina.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Porta no HOST. Aplicações que rodam fora do Docker (ex.: finance-insights)
# conectam em localhost:<esta porta>.
POSTGRES_PORT=5432
# Bancos garantidos a cada `docker compose up` (lista separada por vírgula).
# Para plugar um projeto novo neste servidor, acrescente o nome do banco aqui.
POSTGRES_DATABASES=election_pool,finance_insights

# Banco que a api do election-pool usa (precisa estar na lista acima).
ELECTION_POOL_DB=election_pool

# ─── Portas do election-pool no host ──────────────────────────────────────────
# Site estático servido pelo nginx.
SITE_PORT=8080
# /health interno da api (só no loopback).
HEALTH_PORT=8081

# ─── Comportamento de boot da api ─────────────────────────────────────────────
# Semeia as tabelas de referência (corridas, institutos, candidatos, aliases).
# Idempotente. Em produção isto é um passo de deploy, não de boot: use `false`.
SEED_REFERENCE_ON_BOOT=true

# Roda discovery → harvest → model UMA vez logo após o boot, em vez de esperar o
# próximo tick do cron (docs/02 §3: a cada 2h). Útil para ver o pipeline agora.
# `false` em produção.
RUN_JOBS_ON_BOOT=true

# Dispara o RenderJob no boot, DEPOIS do model. Existe porque o gate M-7
# (backtest 2022) reprova hoje (docs/OPEN-QUESTIONS Q-07) e, por isso, o ModelJob
# NÃO dispara o render sozinho. Isto NÃO relaxa gate nenhum: o RenderJob continua
# aplicando todos os gates de publicação de docs/07 §6 (cobertura do modelo, build
# limpo, frescor, prosa de terceiros). Serve para ver a página com o dado que
# existe. MANTENHA `false` em produção.
RENDER_ON_BOOT=true

# Publica o "estado vazio explicado" quando AINDA NÃO existe site no ar e o único
# gate reprovado é o do modelo (cobertura insuficiente). Sem isto o nginx devolve
# 404 e não dá para distinguir "quebrou" de "ainda não há pesquisa". Nunca
# substitui um site bom por placeholder, e não afrouxa nenhum outro gate.
PUBLISH_PLACEHOLDER_WHEN_EMPTY=true

# ─── Proveniência e alertas ───────────────────────────────────────────────────
# Vai para o campo `gitSha` do data.json. Em produção o CI injeta o SHA real.
GIT_SHA=local
# Destino de alerta (docs/02 §5). Vazio ⇒ o alerta vira log de erro no stdout.
ALERT_WEBHOOK_URL=
