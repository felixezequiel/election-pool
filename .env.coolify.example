# Variáveis de ambiente da aplicação NO COOLIFY (deploy da VPS 31.97.243.112).
# NÃO é lido por `docker compose` local — é a referência do que configurar na
# aba Environment Variables da aplicação `election-pool` no Coolify. Os valores
# reais (senha do banco etc.) vivem SÓ no Coolify, nunca neste repo.
#
# Usado por docker-compose.coolify.yml.

# ── Postgres COMPARTILHADO já existente no Coolify ────────────────────────────
# É o mesmo servidor que o smart-shelf usa. O host é o NOME DO CONTAINER do banco
# na rede `coolify` (não um IP). O election-pool usa um database DEDICADO dentro
# dele (`ELECTION_POOL_DB`), criado pelo serviço `db-init` no deploy.
PG_HOST=lbdcpu1zuqhbapfqg7qxrdjm
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=<senha do Postgres do Coolify — marcar como secret>
ELECTION_POOL_DB=election_pool

# ── Domínio (variável mágica do Coolify para compose) ─────────────────────────
# Gera as labels do Traefik + TLS para a porta 80 do serviço nginx. Aceita mais de
# um FQDN separado por vírgula. O sslip.io resolve sozinho (embute o IP), então o
# site fica no ar sem depender de DNS; eleicoes.fgti.cloud exige um registro A
# eleicoes.fgti.cloud -> 31.97.243.112 antes do TLS emitir.
SERVICE_FQDN_NGINX_80=https://election-pool.31.97.243.112.sslip.io,https://eleicoes.fgti.cloud

# ── Comportamento de boot da api ──────────────────────────────────────────────
# Enquanto não há dado real passando pelos gates (Q-07/Q-09), estes quatro deixam
# o "estado vazio explicado" no ar. Quando houver dado bom, mude para `false` e
# deixe o cron interno (docs/02 §3) publicar.
SEED_REFERENCE_ON_BOOT=true
RUN_JOBS_ON_BOOT=true
RENDER_ON_BOOT=true
PUBLISH_PLACEHOLDER_WHEN_EMPTY=true

# Destino de alerta (docs/02 §5). Vazio ⇒ alerta vira log de erro no stdout.
ALERT_WEBHOOK_URL=
